---
interface Props {
  proof: {
    quote: string;
    name: string;
    role: string;
    stats: { value: number; suffix: string; label: string }[];
  };
  /** Number grouping follows the site language, not a constant. */
  locale: string;
}
const { proof, locale } = Astro.props;
---

<section class="section proof-section" id="proof">
  {/*
    The only thing on the page that moves on its own behind text. It is a 4%
    navy wash on a 96-second crossing — slow enough that you cannot catch it
    moving, and faint enough that at its densest the quote over it still
    measures 10.7:1 and the attribution, which is the palest type here, 4.97:1.
    It is behind everything (z-index -1) and inside an overflow:hidden section,
    so it can neither catch a click nor widen the page.
  */}
  <span class="proof__wash" aria-hidden="true"></span>

  <div class="wrap proof">
    <figure class="proof__quote">
      <span class="rule reveal reveal--rule" aria-hidden="true"></span>
      <blockquote class="reveal" style="--rd:0.08s">{proof.quote}</blockquote>
      <figcaption>
        <strong class="reveal" style="--rd:0.22s">{proof.name}</strong>
        <span class="reveal" style="--rd:0.3s">{proof.role}</span>
      </figcaption>
    </figure>

    <dl class="proof__stats">
      {
        proof.stats.map((s, i) => {
          const base = 0.12 + i * 0.12;
          return (
            <div class="stat">
              <span class="stat__rule reveal reveal--rule" aria-hidden="true" style={`--rd:${base.toFixed(2)}s`} />
              {/* The finished number is in the markup; the script animates from
                  zero only once it is on screen, so no-JS shows the real figure
                  rather than a zero. */}
              {/* No line break between the value and its suffix: JSX would
                  render the newline as a space and turn "40+" into "40 +". */}
              <dt data-count={s.value} class="reveal" style={`--rd:${(base + 0.08).toFixed(2)}s`}>
                <span data-count-value>{s.value.toLocaleString(locale)}</span>{s.suffix}
              </dt>
              <dd class="reveal" style={`--rd:${(base + 0.14).toFixed(2)}s`}>{s.label}</dd>
            </div>
          );
        })
      }
    </dl>
  </div>
</section>

<style>
  .proof-section {
    position: relative;
    isolation: isolate;
    overflow: hidden;
  }
  .proof__wash {
    position: absolute;
    inset: -20%;
    z-index: -1;
    pointer-events: none;
    background: radial-gradient(
      52% 58% at 30% 42%,
      color-mix(in srgb, var(--accent-fill) 4%, transparent),
      transparent 68%
    );
    animation: atlas-drift 96s ease-in-out infinite alternate;
  }
  /* The motion toggle in the client band stops this too. Scoped so it outranks
     the `animation` shorthand above — see global.css. */
  html.motion-paused .proof__wash {
    animation-play-state: paused;
  }

  .proof {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    gap: clamp(40px, 7vw, 88px);
    align-items: start;
  }
  .proof__quote blockquote {
    margin: 22px 0 0;
    font-family: var(--font-display);
    font-size: clamp(21px, 2.8vw, 29px);
    line-height: 1.35;
    letter-spacing: -0.01em;
  }
  .proof__quote figcaption {
    margin-top: 24px;
    font-size: 14.5px;
  }
  .proof__quote strong {
    display: block;
    font-weight: 600;
  }
  .proof__quote figcaption span {
    display: block;
    color: var(--ink-3);
  }

  .proof__stats {
    margin: 0;
    display: grid;
    gap: 26px;
  }
  .stat {
    padding-top: 14px;
    transition: transform 0.35s var(--ease);
  }
  .stat:hover {
    transform: translateY(-3px);
  }
  .stat__rule {
    display: block;
    width: 34px;
    height: 2px;
    background: var(--line-2);
    transform-origin: left center;
    margin-bottom: 10px;
    /* Hover and reveal transitions in one declaration — a second `transition`
       shorthand on a scoped selector outranks `.reveal--rule` and would drop
       the stagger. Only the reveal properties take the delay. */
    transition: opacity 0.3s linear, transform 0.85s var(--ease), background-color 0.3s ease,
      width 0.35s var(--ease);
    transition-delay: var(--rd, 0s), var(--rd, 0s), 0s, 0s;
  }
  .stat:hover .stat__rule {
    background: var(--accent-fill);
    width: 54px;
  }
  .proof__stats dt {
    font-family: var(--font-display);
    font-size: 32px;
    color: var(--accent);
  }
  .proof__stats dd {
    margin: 4px 0 0;
    font-size: 14.5px;
    color: var(--ink-2);
  }

  @media (max-width: 820px) {
    .proof {
      grid-template-columns: 1fr;
    }
    .proof__stats {
      grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
    }
  }
</style>
