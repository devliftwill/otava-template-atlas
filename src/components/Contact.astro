---
import Words from "./Words.astro";

interface Props {
  contact: {
    title: string;
    body: string;
    email: string;
    phone: string;
    address: string;
    form: { name: string; email: string; message: string; submit: string };
  };
}
const { contact } = Astro.props;
const f = contact.form;
---

<section class="section" id="contact">
  <div class="wrap contact">
    <div class="contact__copy">
      <span class="rule reveal reveal--rule" aria-hidden="true"></span>
      <h2 class="contact__title"><Words text={contact.title} start={0.06} /></h2>
      <p class="lede contact__body reveal" style="--rd:0.26s">{contact.body}</p>
      <ul class="contact__list">
        <li class="reveal" style="--rd:0.34s">
          <a href={`mailto:${contact.email}`}><span>{contact.email}</span></a>
        </li>
        <li class="reveal" style="--rd:0.42s">
          <a href={`tel:${contact.phone.replace(/\s+/g, "")}`}><span>{contact.phone}</span></a>
        </li>
        <li class="reveal" style="--rd:0.5s">{contact.address}</li>
      </ul>
    </div>

    {/*
      A plain mailto form: it works the moment the site is published, with no
      account to create and no key to paste. Point `action` at a form endpoint
      (Formspree, Basin, your own handler) when real submissions are wanted —
      that is one attribute, and until then this is honest rather than a form
      that silently drops what people write.
    */}
    <form class="contact__form" action={`mailto:${contact.email}`} method="post" enctype="text/plain">
      <label class="reveal" style="--rd:0.12s">
        <span>{f.name}</span>
        <input type="text" name="name" required autocomplete="name" />
      </label>
      <label class="reveal" style="--rd:0.2s">
        <span>{f.email}</span>
        <input type="email" name="email" required autocomplete="email" />
      </label>
      <label class="reveal" style="--rd:0.28s">
        <span>{f.message}</span>
        <textarea name="message" rows="4" required></textarea>
      </label>
      <span class="reveal contact__send" style="--rd:0.36s">
        <button class="btn btn--primary" type="submit">
          {f.submit}
          <svg class="btn__arrow" width="14" height="10" viewBox="0 0 14 10" fill="none" aria-hidden="true">
            <path d="M1 5h11M8.5 1.5 12 5l-3.5 3.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
      </span>
    </form>
  </div>
</section>

<style>
  .contact {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(40px, 6vw, 72px);
    align-items: start;
  }
  .contact__title {
    margin-top: 20px;
  }
  .contact__body {
    margin-top: 20px;
  }
  .contact__list {
    list-style: none;
    margin: 30px 0 0;
    padding: 0;
    display: grid;
    gap: 8px;
    font-size: 16px;
    color: var(--ink-2);
  }
  .contact__list a {
    text-decoration: none;
    transition: color 0.25s ease;
  }
  /* --line-3, not --line-2: this underline is the only thing marking the
     address and the phone number as links, so it has to clear 3:1. */
  .contact__list a span {
    position: relative;
    display: inline-block;
    border-bottom: 1px solid var(--line-3);
    transition: border-color 0.25s ease;
  }
  .contact__list a span::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 1px;
    background: var(--accent-fill);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 0.35s var(--ease);
  }
  .contact__list a:hover {
    color: var(--ink);
  }
  .contact__list a:hover span::after,
  .contact__list a:focus-visible span::after {
    transform: none;
  }

  .contact__form {
    display: grid;
    gap: 16px;
    background: var(--paper-2);
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: clamp(20px, 3vw, 30px);
    transition: border-color 0.35s ease, box-shadow 0.35s var(--ease);
  }
  .contact__form:focus-within {
    border-color: var(--line-2);
    box-shadow: 0 18px 40px -34px rgba(20, 24, 31, 0.75);
  }
  .contact__form label {
    display: grid;
    gap: 7px;
  }
  .contact__form label > span {
    font-size: 13.5px;
    color: var(--ink-2);
    transition: color 0.25s ease;
  }
  /* The field you are in says so in three ways at once — the label darkens,
     the border becomes navy and the field lifts off the panel. */
  .contact__form label:focus-within > span {
    color: var(--accent);
  }
  .contact__form input,
  .contact__form textarea {
    font: inherit;
    /* 16px, not 15: iOS zooms the whole page when a field smaller than that
       takes focus, and the visitor then has to pinch back out mid-enquiry. */
    font-size: 16px;
    padding: 11px 13px;
    /* The border IS the field — there is no fill to distinguish it from the
       panel behind it — so it is a user interface component boundary at 3:1,
       not a decorative hairline. --line-2 measured 1.5:1 on white and the
       fields effectively had no edge. */
    border: 1px solid var(--line-3);
    border-radius: var(--radius);
    background: var(--paper);
    color: var(--ink);
    width: 100%;
    transition: border-color 0.25s ease, box-shadow 0.25s var(--ease), transform 0.25s var(--ease);
  }
  .contact__form textarea {
    resize: vertical;
  }
  .contact__form input:hover,
  .contact__form textarea:hover {
    border-color: var(--ink-3);
  }
  .contact__form input:focus,
  .contact__form textarea:focus {
    outline: none;
    border-color: var(--accent-fill);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent-fill) 14%, transparent);
    transform: translateY(-1px);
  }
  /* Keyboard users still get the standard ring on top of the above. */
  .contact__form input:focus-visible,
  .contact__form textarea:focus-visible {
    outline: 2px solid var(--accent-fill);
    outline-offset: 1px;
  }

  .contact__send {
    justify-self: start;
  }

  @media (max-width: 820px) {
    .contact {
      grid-template-columns: 1fr;
    }
  }
</style>
